# Host-side overrides for running FastAPI from PyCharm while infrastructure
# and the Celery worker run in Docker.
APP_ENV=development
AUTH_DEV_MODE=true
REQUIRE_AUTH=false
ALLOW_MEMORY_FALLBACK=false

PERSISTENCE_BACKEND=postgresql
DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5433/financial_agent

REDIS_URL=redis://127.0.0.1:6380/0
CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2
REDIS_IDEMPOTENCY_ENABLED=true

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9002
OBJECT_STORAGE_BUCKET=financial-agent
OBJECT_STORAGE_ENABLED=true
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me-too

VECTOR_STORE_BACKEND=qdrant
VECTOR_STORE_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=financial-agent
QDRANT_TIMEOUT_SECONDS=10
