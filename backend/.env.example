APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Local stateful dependencies (Compose provides these services)
DATABASE_URL=postgresql+psycopg://app:password@postgres:5432/financial_agent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=financial-agent
OBJECT_STORAGE_ENABLED=true
AWS_ACCESS_KEY_ID=replace-at-runtime
AWS_SECRET_ACCESS_KEY=replace-at-runtime

# Qdrant Cloud
VECTOR_STORE_BACKEND=qdrant
VECTOR_STORE_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=financial-agent-documents
QDRANT_TIMEOUT_SECONDS=10

# Alibaba Cloud Bailian OpenAI-compatible embeddings
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3
# Set this to the dimension returned by the selected model and collection.
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16

# OpenAI-compatible DeepSeek chat endpoint
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-deepseek-api-key
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_MAX_RETRIES=2
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_READ_TIMEOUT_SECONDS=60

AUTH_DEV_MODE=true
REQUIRE_AUTH=false
ALLOW_MEMORY_FALLBACK=false
PERSISTENCE_BACKEND=postgresql
REDIS_IDEMPOTENCY_ENABLED=true
AUDIT_RETENTION_DAYS=2555

# Production deployments must provide OIDC/JWT configuration.
JWT_ISSUER=https://your-oidc-issuer/
JWT_AUDIENCE=financial-agent
JWT_JWKS_URL=
JWT_HS256_SECRET=
