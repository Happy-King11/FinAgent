FROM python:3.12-slim

WORKDIR /opt/embedding
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/models

COPY embedding-requirements.txt .
RUN pip install --no-cache-dir -r embedding-requirements.txt
COPY scripts/embedding_server.py .

EXPOSE 8000
CMD ["uvicorn", "embedding_server:app", "--host", "0.0.0.0", "--port", "8000"]
