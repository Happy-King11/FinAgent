# Local-only development credentials and host port mappings.
# Copy this file to infrastructure.env before starting the stack.
POSTGRES_DB=financial_agent
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

REDIS_HOST_PORT=6380

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003
OBJECT_STORAGE_BUCKET=financial-agent

QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
QDRANT_COLLECTION=financial-agent
